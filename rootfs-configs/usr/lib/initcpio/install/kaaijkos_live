#!/bin/bash

build() {
    for mod in \
        loop overlay squashfs iso9660 isofs vfat fat nls_cp437 nls_iso8859_1 ext4 \
        cdrom sr_mod sd_mod sg \
        nvme nvme_core ahci libahci ata_piix ata_generic pata_acpi \
        usb_storage uas xhci_pci xhci_hcd ehci_pci ehci_hcd uhci_hcd ohci_pci ohci_hcd usbhid hid_generic \
        virtio virtio_ring virtio_pci virtio_blk virtio_scsi virtio_net \
        vmw_pvscsi mptspi mptscsih mptbase megaraid_sas smartpqi; do
        add_module "$mod" 2>/dev/null || true
    done

    for bin in blkid losetup mount umount mkdir sleep cat chmod ln rm sed seq; do
        add_binary "$bin" 2>/dev/null || true
    done

    add_runscript
}

help() {
    cat << 'HELPEOF'
KaaijkOS universal Live ISO boot hook with SquashFS and OverlayFS support.
HELPEOF
}
