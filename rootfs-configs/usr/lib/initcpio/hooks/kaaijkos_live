#!/usr/bin/ash

kaaijkos_mount_handler() {
    echo ":: Searching for KaaijkOS installation media..."
    ISO_DEV=""
    for i in $(seq 1 30); do
        ISO_DEV=$(blkid -L "KAAIJKOS_1_0" 2>/dev/null)
        [ -z "$ISO_DEV" ] && ISO_DEV=$(blkid -L "KAAIJKOS_LIVE" 2>/dev/null)

        if [ -z "$ISO_DEV" ]; then
            for dev in /dev/sr* /dev/cdrom* /dev/sd* /dev/vd* /dev/nvme*; do
                if [ -b "$dev" ]; then
                    mkdir -p /run/test_iso
                    if mount -o ro "$dev" /run/test_iso 2>/dev/null; then
                        if [ -f /run/test_iso/kaaijkos/system.sfs ] || [ -f /run/test_iso/live/rootfs.sfs ]; then
                            ISO_DEV="$dev"
                            umount /run/test_iso 2>/dev/null
                            break
                        fi
                        umount /run/test_iso 2>/dev/null
                    fi
                fi
            done
        fi

        [ -n "$ISO_DEV" ] && break
        sleep 1
    done

    if [ -z "$ISO_DEV" ]; then
        echo ":: ERROR: KaaijkOS installation media not found!"
        launch_interactive_shell
        return 1
    fi

    echo ":: Found KaaijkOS media on $ISO_DEV"
    mkdir -p /run/iso
    mount -o ro "$ISO_DEV" /run/iso

    SFS_PATH=""
    if [ -f /run/iso/kaaijkos/system.sfs ]; then
        SFS_PATH="/run/iso/kaaijkos/system.sfs"
    elif [ -f /run/iso/live/rootfs.sfs ]; then
        SFS_PATH="/run/iso/live/rootfs.sfs"
    fi

    if [ -z "$SFS_PATH" ]; then
        echo ":: ERROR: SquashFS system image not found on media!"
        launch_interactive_shell
        return 1
    fi

    echo ":: Mounting KaaijkOS Live SquashFS ($SFS_PATH)..."
    mkdir -p /run/sfs
    mount -t squashfs -o loop,ro "$SFS_PATH" /run/sfs

    mkdir -p /run/overlay
    mount -t tmpfs -o size=75%,mode=0755 tmpfs /run/overlay
    mkdir -p /run/overlay/upper /run/overlay/work

    echo ":: Activating OverlayFS on $1..."
    mount -t overlay overlay -o lowerdir=/run/sfs,upperdir=/run/overlay/upper,workdir=/run/overlay/work "$1"

    mkdir -p "$1/run/iso" "$1/run/sfs"
    mount --bind /run/iso "$1/run/iso"
    mount --bind /run/sfs "$1/run/sfs"

    cat << 'FSTAB_EOF' > "$1/etc/fstab"
# KaaijkOS Live Environment
tmpfs /tmp tmpfs defaults,nosuid,nodev 0 0
FSTAB_EOF

    mkdir -p "$1/etc/systemd/system/getty@tty1.service.d"
    cat << 'GETTY_EOF' > "$1/etc/systemd/system/getty@tty1.service.d/live-autologin.conf"
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --autologin root --noclear %I $TERM
Type=idle
GETTY_EOF

    mkdir -p "$1/etc/profile.d"
    cat << 'PROF_EOF' > "$1/etc/profile.d/zz-kaaijkos-live-installer.sh"
if [ "$(tty 2>/dev/null)" = "/dev/tty1" ] && [ -d /run/sfs ] && [ -x /usr/local/bin/kaaijkos-install ]; then
    /usr/local/bin/kaaijkos-install
    echo ""
    echo "================================================================"
    echo "  KaaijkOS 1.0 Live Rescue Shell"
    echo "  Run 'kaaijkos-install' at any time to restart the installer."
    echo "================================================================"
    echo ""
fi
PROF_EOF
    chmod 755 "$1/etc/profile.d/zz-kaaijkos-live-installer.sh"

    echo ":: KaaijkOS Live environment ready."
}

run_hook() {
    mount_handler=kaaijkos_mount_handler
}
