#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    install|add|i)
        shift
        [ $# -ge 1 ] || { echo "Usage: kosapps install <package...>"; exit 1; }
        for p in "$@"; do
            nix profile add "nixpkgs#${p}"
        done
        ;;
    remove|rm|uninstall)
        shift
        [ $# -ge 1 ] || { echo "Usage: kosapps remove <package...>"; exit 1; }
        nix profile remove "$@"
        ;;
    search|s)
        shift
        [ $# -ge 1 ] || { echo "Usage: kosapps search <query>"; exit 1; }
        nix search nixpkgs "$*"
        ;;
    list|ls)
        nix profile list
        ;;
    update|upgrade|up)
        nix profile upgrade --all
        ;;
    clean)
        nix-collect-garbage -d
        ;;
    *)
        cat << 'HELP'
KaaijkOS Apps (kosapps) - Powered by Nix
  kosapps install <package...>   Install one or more packages
  kosapps remove <package...>    Remove installed packages
  kosapps search <query>         Search >100,000 packages
  kosapps list                   List installed packages
  kosapps upgrade                Upgrade all installed packages
  kosapps clean                  Remove old package generations & garbage
HELP
        exit 1
        ;;
esac
