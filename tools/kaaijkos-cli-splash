#!/usr/bin/env python3
"""
KaaijkOS 1.1 — CLI Boot Splash (kaaijkos-cli-splash 1.0)
Toont een strak CLI-laadscherm op tty1 in exact dezelfde stijl als kaaijkos-greeter
(gekleurd K-logo + geanimeerde laadbalk & spinner in de kleuren van de K)
wanneer gestart met kernel-parameter 'kaaijkos.cli-splash' (zonder Plymouth).
"""
from __future__ import annotations

import argparse
import re
import shutil
import sys
import time

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")

LOGO = [
    "                        -=----",
    "            :--        =====--",
    "         ---===      ++++====-",
    "        --===++   =++++++++   ",
    "        ==++*#%+=++++++++     ",
    "        ++###++++++++++       ",
    "        ##*++++++++++         ",
    "        +++++***++====        ",
    "        +++++++======+++++    ",
    "        ==+++++ ===+++++++++  ",
    "        -=====+    ++++++++===",
    "            -==       +++====-",
]

R = "\x1b[0m"
DIM = "\x1b[2m"
CYAN = "\x1b[1;36m"
BLUE = "\x1b[1;34m"
MAGENTA = "\x1b[1;35m"
RED = "\x1b[1;31m"
YELLOW = "\x1b[1;33m"
WHITE = "\x1b[1;37m"

SPINNER_SEQ = [
    (CYAN, "|"),
    (BLUE, "/"),
    (MAGENTA, "-"),
    (RED, "\\"),
    (YELLOW, "|"),
    (CYAN, "/"),
    (BLUE, "-"),
    (MAGENTA, "\\"),
]

BAR_COLORS = [YELLOW, RED, MAGENTA, BLUE, CYAN]


def color_logo_line(r: int, line: str) -> str:
    out: list[str] = []
    for c, ch in enumerate(line):
        if ch == " ":
            out.append(" ")
            continue
        if c <= 15 and r <= 4:
            col = YELLOW if r <= 2 else RED
        elif c <= 15:
            col = BLUE if r <= 8 else CYAN
        elif r <= 6:
            col = CYAN
        else:
            col = MAGENTA
        out.append(f"{col}{ch}")
    out.append(R)
    return "".join(out)


def render_bar(pct: float, width: int = 30) -> str:
    filled = max(0, min(width, int(round(pct * width))))
    parts = [f"{DIM}[{R}"]
    for i in range(width):
        if i < filled:
            col = BAR_COLORS[min(len(BAR_COLORS) - 1, (i * len(BAR_COLORS)) // width)]
            parts.append(f"{col}={R}")
        elif i == filled and filled < width:
            parts.append(f"{WHITE}>{R}")
        else:
            parts.append(f"{DIM}-{R}")
    parts.append(f"{DIM}]{R}")
    return "".join(parts)


def _center_line(text: str, cols: int) -> str:
    vis = len(ANSI_RE.sub("", text))
    pad = max(0, (cols - vis) // 2)
    return f"{' ' * pad}{text}\x1b[K"


def build_frame(step: int, total_steps: int, cols: int, rows: int, full_clear: bool = False) -> str:
    pct = min(1.0, step / max(1, total_steps))
    sp_col, sp_ch = SPINNER_SEQ[step % len(SPINNER_SEQ)]

    if pct < 0.35:
        status = "Initializing system..."
    elif pct < 0.75:
        status = "Starting services..."
    elif pct < 1.0:
        status = "Preparing console..."
    else:
        status = "Ready."

    title = f"{CYAN}KaaijkOS 1.1{R}  {DIM}|{R}  {WHITE}CLI{R}"
    bar_line = f"{render_bar(pct, 32)}  {sp_col}{sp_ch}{R}"
    stat_line = f"{DIM}{status}{R}"

    logo_pad = max(0, (cols - 34) // 2)
    lpad = " " * logo_pad
    lines: list[str] = [f"{lpad}{color_logo_line(i, raw)}\x1b[K" for i, raw in enumerate(LOGO)]
    lines.append("\x1b[K")
    lines.append(_center_line(title, cols))
    lines.append("\x1b[K")
    lines.append(_center_line(bar_line, cols))
    lines.append(_center_line(stat_line, cols))

    top_pad = max(1, (rows - len(lines)) // 2)
    out = ["\x1b[?25l\x1b[H\x1b[2J" if full_clear else "\x1b[?25l\x1b[H"]
    for _ in range(top_pad):
        out.append("\x1b[K\n")
    for line in lines:
        out.append(f"{line}\n")
    out.append("\x1b[J")
    return "".join(out)


def self_check() -> int:
    for step in (0, 8, 16, 24):
        frame = build_frame(step, 24, 80, 25, full_clear=(step == 0))
        for line in frame.splitlines():
            plain = ANSI_RE.sub("", line)
            assert len(plain) <= 80, f"Line too wide ({len(plain)}): {plain!r}"
            assert all(ord(c) < 128 for c in plain), f"Non-ASCII in line: {plain!r}"
    print("[kaaijkos-cli-splash --check] OK: <=80 cols pure ASCII + 16-color ANSI verified.")
    return 0


def run_splash(duration: float = 1.4) -> int:
    steps = 24
    delay = duration / steps
    prev_size = (0, 0)
    try:
        sys.stdout.write("\x1b[?25l\x1b[H\x1b[2J")
        sys.stdout.flush()
        for s in range(steps + 1):
            cur_size = shutil.get_terminal_size((80, 25))
            resized = (cur_size != prev_size)
            prev_size = cur_size
            sys.stdout.write(build_frame(s, steps, cur_size.columns, cur_size.lines, full_clear=resized))
            sys.stdout.flush()
            time.sleep(delay)
        time.sleep(0.12)
        sys.stdout.write("\x1b[H\x1b[2J\x1b[?25h")
        sys.stdout.flush()
    except Exception:
        sys.stdout.write("\x1b[?25h")
        sys.stdout.flush()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description="KaaijkOS 1.1 CLI Boot Splash")
    ap.add_argument("--check", action="store_true", help="Run self-tests and exit")
    ap.add_argument("--demo", action="store_true", help="Print one static frame and exit")
    ap.add_argument("--duration", type=float, default=1.4, help="Splash duration in seconds")
    args = ap.parse_args()

    if args.check:
        return self_check()
    if args.demo:
        print(build_frame(14, 24, 80, 25))
        return 0
    return run_splash(duration=args.duration)


if __name__ == "__main__":
    sys.exit(main())
