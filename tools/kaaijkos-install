#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# KaaijkOS 1.0 - Full Interactive System Installer (Subiquity / Ubuntu Server TUI)
# Supports: UEFI (systemd-boot + UKI) & Legacy BIOS (GRUB i386-pc)
#           Guided & Custom Partitioning | Full Network Configuration
#           All System Keymaps, Locales & Timezones | GitHub SSH Key Import
# ==============================================================================

DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: Please run kaaijkos-install as root." >&2
    exit 1
fi

command -v dialog >/dev/null || { echo "Error: 'dialog' is not installed." >&2; exit 1; }

LOG_FILE="/tmp/kaaijkos-install.log"
: > "$LOG_FILE"

if [ -d /sys/firmware/efi ]; then
    BOOT_MODE="UEFI"
else
    BOOT_MODE="BIOS"
fi
CPU_MODEL=$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null || echo "x86_64 Processor")
RAM_TOTAL=$(free -h | awk '/^Mem:/{print $2}')
BACKTITLE="KaaijkOS 1.0 Installer  |  Firmware: ${BOOT_MODE}  |  RAM: ${RAM_TOTAL}  |  ${CPU_MODEL}"
[[ "$DRY_RUN" -eq 1 ]] && BACKTITLE="[DRY-RUN / SIMULATION]  ${BACKTITLE}"

export DIALOGRC="/tmp/kaaijkos-dialogrc"
cat << 'THEME' > "$DIALOGRC"
use_shadow = OFF
use_colors = ON
screen_color = (CYAN,BLACK,ON)
dialog_color = (WHITE,BLACK,OFF)
title_color = (CYAN,BLACK,ON)
border_color = (CYAN,BLACK,ON)
button_active_color = (BLACK,CYAN,ON)
button_inactive_color = (WHITE,BLACK,OFF)
button_key_active_color = (BLACK,CYAN,ON)
button_key_inactive_color = (CYAN,BLACK,ON)
button_label_active_color = (BLACK,CYAN,ON)
button_label_inactive_color = (WHITE,BLACK,ON)
inputbox_color = (WHITE,BLACK,OFF)
inputbox_border_color = (CYAN,BLACK,ON)
menubox_color = (WHITE,BLACK,OFF)
menubox_border_color = (CYAN,BLACK,ON)
item_color = (WHITE,BLACK,OFF)
item_selected_color = (BLACK,CYAN,ON)
tag_color = (CYAN,BLACK,ON)
tag_selected_color = (BLACK,CYAN,ON)
tag_key_color = (CYAN,BLACK,ON)
tag_key_selected_color = (BLACK,CYAN,ON)
check_color = (WHITE,BLACK,OFF)
check_selected_color = (BLACK,CYAN,ON)
gauge_color = (BLACK,CYAN,ON)
border2_color = (CYAN,BLACK,ON)
inputbox_border2_color = (CYAN,BLACK,ON)
menubox_border2_color = (CYAN,BLACK,ON)
THEME

MNT="/mnt/kaaijkos-target"
NET_CONFIG_DIR="/tmp/kaaijkos-netconf"
rm -rf "$NET_CONFIG_DIR" && mkdir -p "$NET_CONFIG_DIR"

cleanup() {
    rm -f "$DIALOGRC"
    rm -rf "$NET_CONFIG_DIR"
    if [ "$DRY_RUN" -eq 0 ]; then
        umount -R "$MNT" 2>/dev/null || true
    fi
}
trap cleanup EXIT

dlg() {
    dialog --backtitle "$BACKTITLE" --stdout "$@"
}

abort_install() {
    clear
    echo "Installation cancelled by user."
    exit 1
}

part_prefix() {
    local d="$1"
    if [[ "$d" =~ [0-9]$ ]]; then echo "${d}p"; else echo "${d}"; fi
}

# ------------------------------------------------------------------------------
# 1. WELCOME
# ------------------------------------------------------------------------------
dlg --title " Welcome to KaaijkOS 1.0 " --yes-label "Continue" --no-label "Exit" \
    --yesno "\nWelcome to the KaaijkOS 1.0 System Installer.\n\nDetected Hardware Environment:\n  • Firmware Mode : ${BOOT_MODE}\n  • Processor     : ${CPU_MODEL}\n  • System Memory : ${RAM_TOTAL}\n\nThis installer will guide you through:\n  1. Keyboard layout, system locale & timezone (full system lists)\n  2. Network configuration (IPv4/IPv6 DHCP, Static IP, DNS, Wi-Fi)\n  3. Storage configuration (Guided whole-disk or Custom manual layout)\n  4. Profile setup (Hostname, root/sudo users & GitHub SSH keys)\n\nProceed with installation?" 20 76 || abort_install

# ------------------------------------------------------------------------------
# 2. KEYBOARD LAYOUT (FULL SYSTEM LIST)
# ------------------------------------------------------------------------------
KEYMAP_ITEMS=(
    "us"        "English (US) - Default"
    "nl"        "Dutch (Netherlands)"
    "de"        "German (Germany)"
    "de-latin1" "German (latin1)"
    "be-latin1" "Belgian (AZERTY)"
    "uk"        "English (UK)"
    "fr"        "French (AZERTY)"
    "es"        "Spanish"
    "it"        "Italian"
    "pl"        "Polish"
    "se-lat6"   "Swedish"
)
while IFS= read -r km; do
    case "$km" in
        us|nl|de|de-latin1|be-latin1|uk|fr|es|it|pl|se-lat6) continue ;;
    esac
    KEYMAP_ITEMS+=("$km" "Keymap ($km)")
done < <(find /usr/share/kbd/keymaps -type f -name "*.map.gz" -printf "%f\n" 2>/dev/null | sed 's/\.map\.gz$//' | sort -u)

KEYMAP=$(dlg --title " Keyboard Configuration " \
    --menu "\nSelect your keyboard layout (use PageUp/PageDown or type to scroll):" 20 70 12 \
    "${KEYMAP_ITEMS[@]}") || abort_install

loadkeys "$KEYMAP" >>"$LOG_FILE" 2>&1 || true

# ------------------------------------------------------------------------------
# 3. SYSTEM LOCALE (FULL UTF-8 LIST FROM /etc/locale.gen)
# ------------------------------------------------------------------------------
LOCALE_ITEMS=(
    "en_US.UTF-8" "English (United States) - Recommended"
    "nl_NL.UTF-8" "Dutch (Netherlands)"
    "nl_BE.UTF-8" "Dutch (Belgium)"
    "en_GB.UTF-8" "English (Great Britain)"
    "de_DE.UTF-8" "German (Germany)"
    "fr_FR.UTF-8" "French (France)"
)
if [ -f /etc/locale.gen ]; then
    while IFS= read -r loc; do
        case "$loc" in
            en_US.UTF-8|nl_NL.UTF-8|nl_BE.UTF-8|en_GB.UTF-8|de_DE.UTF-8|fr_FR.UTF-8) continue ;;
        esac
        LOCALE_ITEMS+=("$loc" "UTF-8 Locale")
    done < <(grep -E '^#?[a-z]{2,3}_[A-Z]{2}\.UTF-8' /etc/locale.gen | sed 's/^#//; s/[[:space:]].*//' | sort -u)
fi

LOCALE=$(dlg --title " System Locale " \
    --menu "\nSelect the system language and regional encoding:" 20 70 12 \
    "${LOCALE_ITEMS[@]}") || abort_install

# ------------------------------------------------------------------------------
# 4. TIMEZONE (ALL REGIONS & CITIES FROM /usr/share/zoneinfo)
# ------------------------------------------------------------------------------
while true; do
    TZ_REGION=$(dlg --title " Timezone - Select Region " \
        --menu "\nSelect your geographic region:" 19 65 11 \
        "Europe"     "European Timezones" \
        "UTC"        "Universal Coordinated Time (Servers)" \
        "America"    "North & South America" \
        "Asia"       "Asia & Middle East" \
        "Africa"     "Africa" \
        "Australia"  "Australia" \
        "Pacific"    "Pacific Ocean & New Zealand" \
        "Atlantic"   "Atlantic Ocean" \
        "Indian"     "Indian Ocean" \
        "Antarctica" "Antarctica" \
        "Arctic"     "Arctic") || abort_install

    if [ "$TZ_REGION" = "UTC" ]; then
        TIMEZONE="UTC"
        break
    fi

    CITY_ITEMS=()
    while IFS= read -r city; do
        CITY_ITEMS+=("$city" "${TZ_REGION}/${city}")
    done < <(find "/usr/share/zoneinfo/${TZ_REGION}" -maxdepth 1 -mindepth 1 \( -type f -o -type l \) -printf "%f\n" 2>/dev/null | sort)

    if TZ_CITY=$(dlg --title " Timezone - Select City (${TZ_REGION}) " \
        --cancel-label "Back to Regions" \
        --menu "\nSelect your city / timezone in ${TZ_REGION}:" 20 68 12 "${CITY_ITEMS[@]}"); then
        TIMEZONE="${TZ_REGION}/${TZ_CITY}"
        break
    fi
done

# ------------------------------------------------------------------------------
# 5. NETWORK CONNECTIONS (UBUNTU SERVER SUBIQUITY STYLE)
# ------------------------------------------------------------------------------
configure_interface() {
    local iface="$1"
    local conf_file="${NET_CONFIG_DIR}/${iface}.env"
    local mode="dhcp"
    local ip4="" gw4="" dns4="1.1.1.1,8.8.8.8" ip6_mode="auto" ip6_addr="" ip6_gw=""
    [ -f "$conf_file" ] && source "$conf_file"

    while true; do
        local action
        action=$(dlg --title " Edit Network Interface: ${iface} " \
            --cancel-label "Back" \
            --menu "\nCurrent settings for ${iface}:\n  • IPv4 Mode : ${mode^^} ${ip4:+($ip4, GW: $gw4)}\n  • DNS       : ${dns4}\n  • IPv6 Mode : ${ip6_mode^^} ${ip6_addr:+($ip6_addr)}\n\nChoose a setting to edit:" 18 72 6 \
            "ipv4"  "Edit IPv4 Configuration (DHCP / Static / Disabled)" \
            "ipv6"  "Edit IPv6 Configuration (Auto / Static / Disabled)" \
            "wifi"  "Connect to a Wi-Fi Network (Wireless interfaces)" \
            "apply" "Apply & Test Connection Live Now" \
            "save"  "[ Save & Return to Network Overview ]") || return 0

        case "$action" in
            ipv4)
                mode=$(dlg --title " IPv4 Method (${iface}) " \
                    --menu "\nSelect IPv4 configuration method for ${iface}:" 13 65 3 \
                    "dhcp"     "Automatic (DHCP)" \
                    "static"   "Manual (Static IPv4, Subnet CIDR, Gateway, DNS)" \
                    "disabled" "Disable IPv4 on this interface") || continue
                if [ "$mode" = "static" ]; then
                    local cur_ip
                    cur_ip=$(ip -4 -br addr show "$iface" 2>/dev/null | awk '{print $3}' | head -n1)
                    local cur_gw
                    cur_gw=$(ip route show default dev "$iface" 2>/dev/null | awk '{print $3}' | head -n1)
                    ip4=$(dlg --title " Static IPv4 Address " --inputbox "\nEnter IPv4 address with CIDR prefix (e.g. 192.168.1.50/24):" 10 68 "${ip4:-${cur_ip:-192.168.1.50/24}}") || continue
                    gw4=$(dlg --title " IPv4 Default Gateway " --inputbox "\nEnter default gateway IPv4 address (leave empty if none):" 10 68 "${gw4:-${cur_gw:-192.168.1.1}}") || continue
                    dns4=$(dlg --title " DNS Servers " --inputbox "\nEnter DNS servers (comma-separated):" 10 68 "${dns4:-1.1.1.1,8.8.8.8}") || continue
                else
                    ip4=""
                    gw4=""
                fi
                ;;
            ipv6)
                ip6_mode=$(dlg --title " IPv6 Method (${iface}) " \
                    --menu "\nSelect IPv6 configuration method for ${iface}:" 13 65 3 \
                    "auto"     "Automatic (SLAAC / DHCPv6)" \
                    "static"   "Manual (Static IPv6 Address & Gateway)" \
                    "disabled" "Disable IPv6 on this interface") || continue
                if [ "$ip6_mode" = "static" ]; then
                    ip6_addr=$(dlg --title " Static IPv6 Address " --inputbox "\nEnter IPv6 address with prefix (e.g. 2a01:4f8::2/64):" 10 68 "${ip6_addr}") || continue
                    ip6_gw=$(dlg --title " IPv6 Gateway " --inputbox "\nEnter IPv6 gateway (e.g. fe80::1):" 10 68 "${ip6_gw}") || continue
                else
                    ip6_addr=""
                    ip6_gw=""
                fi
                ;;
            wifi)
                if command -v nmcli >/dev/null; then
                    nmcli device wifi rescan ifname "$iface" >>"$LOG_FILE" 2>&1 || true
                    local ssid pass
                    ssid=$(dlg --title " Wi-Fi SSID " --inputbox "\nEnter Wi-Fi network name (SSID):" 10 60 "") || continue
                    if [ -n "$ssid" ]; then
                        pass=$(dlg --title " Wi-Fi Password " --insecure --passwordbox "\nEnter Wi-Fi password for '${ssid}':" 10 60) || continue
                        if nmcli device wifi connect "$ssid" password "$pass" ifname "$iface" >>"$LOG_FILE" 2>&1; then
                            dlg --title " Wi-Fi Connected " --msgbox "\nSuccessfully connected to '${ssid}'!" 8 55
                        else
                            dlg --title " Wi-Fi Error " --msgbox "\nCould not connect to '${ssid}'. Check /tmp/kaaijkos-install.log." 9 60
                        fi
                    fi
                else
                    dlg --title " Unavailable " --msgbox "\nnmcli is not available." 8 45
                fi
                ;;
            apply)
                if [ "$DRY_RUN" -eq 0 ] && command -v nmcli >/dev/null; then
                    if [ "$mode" = "static" ] && [ -n "$ip4" ]; then
                        ip addr flush dev "$iface" >>"$LOG_FILE" 2>&1 || true
                        ip addr add "$ip4" dev "$iface" >>"$LOG_FILE" 2>&1 || true
                        ip link set "$iface" up >>"$LOG_FILE" 2>&1 || true
                        [ -n "$gw4" ] && ip route replace default via "$gw4" dev "$iface" >>"$LOG_FILE" 2>&1 || true
                    fi
                fi
                dlg --title " Applied " --msgbox "\nConfiguration saved for ${iface}." 8 50
                ;;
            save)
                cat << ENVEOF > "$conf_file"
IFACE="${iface}"
mode="${mode}"
ip4="${ip4}"
gw4="${gw4}"
dns4="${dns4}"
ip6_mode="${ip6_mode}"
ip6_addr="${ip6_addr}"
ip6_gw="${ip6_gw}"
ENVEOF
                return 0
                ;;
        esac
    done
}

while true; do
    NET_MENU_ITEMS=()
    while IFS= read -r line; do
        ifname=$(echo "$line" | awk '{print $1}')
        ifstate=$(echo "$line" | awk '{print $2}')
        ifip=$(echo "$line" | awk '{print $3}')
        if [ -f "${NET_CONFIG_DIR}/${ifname}.env" ]; then
            # shellcheck disable=SC1090
            source "${NET_CONFIG_DIR}/${ifname}.env"
            NET_MENU_ITEMS+=("$ifname" "Configured: IPv4=${mode^^} ${ip4:-($ifip)} | IPv6=${ip6_mode^^}")
        else
            NET_MENU_ITEMS+=("$ifname" "State: ${ifstate}  |  Current: ${ifip:-DHCP / Unconfigured}")
            cat << DEFENV > "${NET_CONFIG_DIR}/${ifname}.env"
IFACE="${ifname}"
mode="dhcp"
ip4=""
gw4=""
dns4="1.1.1.1,8.8.8.8"
ip6_mode="auto"
ip6_addr=""
ip6_gw=""
DEFENV
        fi
    done < <(ip -br addr | grep -v '^lo')

    NET_MENU_ITEMS+=("DONE" "[ Done - Continue to Storage Configuration ]")

    NET_CHOICE=$(dlg --title " Network Connections " \
        --menu "\nConfigure network interfaces (select an interface to set DHCP, Static IPv4/IPv6, Gateway, DNS or Wi-Fi, or select DONE to continue):" 17 76 6 \
        "${NET_MENU_ITEMS[@]}") || abort_install

    if [ "$NET_CHOICE" = "DONE" ]; then
        break
    else
        configure_interface "$NET_CHOICE"
    fi
done

# ------------------------------------------------------------------------------
# 6. STORAGE CONFIGURATION (GUIDED OR CUSTOM MANUAL LAYOUT)
# ------------------------------------------------------------------------------
STORAGE_MODE=""
TARGET_DISK=""
SWAP_MODE="zram"
SWAP_SIZE="4G"
BOOT_SIZE="512M"
CUSTOM_ROOT_PART=""
CUSTOM_BOOT_PART=""
CUSTOM_HOME_PART=""
CUSTOM_SWAP_PART=""
FORMAT_ROOT="yes"
FORMAT_BOOT="yes"
FORMAT_HOME="no"

select_physical_disk() {
    local items=()
    while IFS= read -r line; do
        local dname="/dev/$(echo "$line" | awk '{print $1}')"
        local dsize
        dsize=$(echo "$line" | awk '{print $2}')
        local dmodel
        dmodel=$(echo "$line" | cut -d' ' -f3-)
        items+=("$dname" "${dsize}  -  ${dmodel:-Disk}")
    done < <(lsblk -d -n -o NAME,SIZE,MODEL -e 7,11 2>/dev/null)
    if [ "${#items[@]}" -eq 0 ]; then
        dlg --title " Error " --msgbox "\nNo storage disks detected!" 8 45
        exit 1
    fi
    dlg --title " Select Target Disk " \
        --menu "\nSelect the disk to use for KaaijkOS 1.0 (${BOOT_MODE} mode):" 16 74 6 "${items[@]}"
}

while true; do
    STORAGE_MODE=$(dlg --title " Storage Configuration " \
        --menu "\nHow would you like to partition your storage?" 14 74 2 \
        "guided" "Guided - Use entire disk (Automatic ${BOOT_MODE} layout + customizable swap)" \
        "custom" "Custom Storage Layout (Manual partitioning with cfdisk & mountpoints)") || abort_install

    if [ "$STORAGE_MODE" = "guided" ]; then
        TARGET_DISK=$(select_physical_disk) || continue
        BOOT_SIZE=$(dlg --title " Boot Partition Size " \
            --inputbox "\nEnter size for /boot partition (e.g. 512M or 1G):" 10 60 "512M") || continue
        SWAP_MODE=$(dlg --title " Swap Configuration " \
            --menu "\nChoose swap configuration:" 14 70 3 \
            "zram" "ZRAM compressed RAM swap (50% of RAM, zstd - Recommended)" \
            "part" "Dedicated Swap Partition on disk" \
            "none" "No swap") || continue
        if [ "$SWAP_MODE" = "part" ]; then
            SWAP_SIZE=$(dlg --title " Swap Partition Size " \
                --inputbox "\nEnter dedicated swap partition size (e.g. 2G, 4G, 8G):" 10 60 "4G") || continue
        fi
        break
    else
        # CUSTOM STORAGE LAYOUT
        TARGET_DISK=$(select_physical_disk) || continue
        while true; do
            PART_TABLE_TEXT=$(lsblk -o NAME,SIZE,FSTYPE,TYPE "$TARGET_DISK" 2>/dev/null)
            CUSTOM_ACT=$(dlg --title " Custom Storage Layout (${TARGET_DISK}) " \
                --menu "\nCurrent partitions on ${TARGET_DISK}:\n${PART_TABLE_TEXT}\n\nAssigned Mountpoints:\n  • Root (/)   : ${CUSTOM_ROOT_PART:-UNASSIGNED} (Format: ${FORMAT_ROOT})\n  • Boot (/boot): ${CUSTOM_BOOT_PART:-None / Inside Root} (Format: ${FORMAT_BOOT})\n  • Home (/home): ${CUSTOM_HOME_PART:-None} (Format: ${FORMAT_HOME})\n  • Swap       : ${CUSTOM_SWAP_PART:-None (ZRAM: $SWAP_MODE)}\n\nSelect an action:" 24 76 6 \
                "cfdisk" "Open Interactive Partition Editor (cfdisk ${TARGET_DISK})" \
                "root"   "Select & Configure Root (/) Partition (Required)" \
                "boot"   "Select & Configure Boot (/boot or EFI) Partition" \
                "home"   "Select & Configure Home (/home) Partition (Optional)" \
                "swap"   "Select & Configure Swap Partition / ZRAM" \
                "done"   "[ Done - Continue with this Custom Layout ]") || break

            list_disk_parts() {
                local pitems=()
                while IFS= read -r pline; do
                    local pname="/dev/$(echo "$pline" | awk '{print $1}')"
                    local psize
                    psize=$(echo "$pline" | awk '{print $2}')
                    local pfs
                    pfs=$(echo "$pline" | awk '{print $3}')
                    pitems+=("$pname" "Size: ${psize}  |  FS: ${pfs:-unformatted}")
                done < <(lsblk -ln -o NAME,SIZE,FSTYPE,TYPE "$TARGET_DISK" | awk '$4=="part"{print $1, $2, $3}')
                if [ "${#pitems[@]}" -eq 0 ]; then
                    dlg --title " No Partitions " --msgbox "\nNo partitions found on ${TARGET_DISK}. Run 'cfdisk' first to create partitions." 9 60
                    return 1
                fi
                dlg --title " Select Partition " --menu "\nChoose a partition from ${TARGET_DISK}:" 15 68 6 "${pitems[@]}"
            }

            case "$CUSTOM_ACT" in
                cfdisk)
                    if [ "$DRY_RUN" -eq 1 ]; then
                        dlg --title " Dry-Run " --msgbox "\nIn real mode, 'cfdisk ${TARGET_DISK}' opens here. In --dry-run mode, we keep your disk untouched and let you select existing partitions." 10 65
                    else
                        clear
                        cfdisk "$TARGET_DISK"
                        partprobe "$TARGET_DISK" 2>/dev/null || true
                    fi
                    ;;
                root)
                    if PSEL=$(list_disk_parts); then
                        CUSTOM_ROOT_PART="$PSEL"
                        if dlg --title " Format Root (/) " --yesno "\nFormat ${CUSTOM_ROOT_PART} as ext4?" 8 55; then
                            FORMAT_ROOT="yes"
                        else
                            FORMAT_ROOT="no"
                        fi
                    fi
                    ;;
                boot)
                    if PSEL=$(list_disk_parts); then
                        CUSTOM_BOOT_PART="$PSEL"
                        if dlg --title " Format /boot " --yesno "\nFormat ${CUSTOM_BOOT_PART} ($([ "$BOOT_MODE" = "UEFI" ] && echo "FAT32 EFI" || echo "ext4"))?" 8 58; then
                            FORMAT_BOOT="yes"
                        else
                            FORMAT_BOOT="no"
                        fi
                    fi
                    ;;
                home)
                    if PSEL=$(list_disk_parts); then
                        CUSTOM_HOME_PART="$PSEL"
                        if dlg --title " Format /home " --yesno "\nFormat ${CUSTOM_HOME_PART} as ext4? (Select 'No' to keep existing data)" 9 62; then
                            FORMAT_HOME="yes"
                        else
                            FORMAT_HOME="no"
                        fi
                    fi
                    ;;
                swap)
                    SWAP_CHOICE=$(dlg --title " Swap Configuration " --menu "\nChoose swap method:" 13 65 3 \
                        "zram" "Use ZRAM compressed memory swap" \
                        "part" "Select a swap partition from ${TARGET_DISK}" \
                        "none" "No swap") || continue
                    if [ "$SWAP_CHOICE" = "part" ]; then
                        if PSEL=$(list_disk_parts); then
                            CUSTOM_SWAP_PART="$PSEL"
                            SWAP_MODE="part"
                        fi
                    else
                        CUSTOM_SWAP_PART=""
                        SWAP_MODE="$SWAP_CHOICE"
                    fi
                    ;;
                done)
                    if [ -z "$CUSTOM_ROOT_PART" ]; then
                        dlg --title " Missing Root Partition " --msgbox "\nYou must assign at least a Root (/) partition before continuing." 8 60
                        continue
                    fi
                    if [ "$BOOT_MODE" = "UEFI" ] && [ -z "$CUSTOM_BOOT_PART" ]; then
                        dlg --title " Missing EFI Boot Partition " --msgbox "\nIn UEFI mode, you must assign an EFI System Partition for /boot." 8 64
                        continue
                    fi
                    break 2
                    ;;
            esac
        done
    fi
done

# ------------------------------------------------------------------------------
# 7. PROFILE SETUP (HOSTNAME, ROOT, OPTIONAL SUDO USER)
# ------------------------------------------------------------------------------
TARGET_HOSTNAME=$(dlg --title " Profile Setup - Hostname " \
    --inputbox "\nEnter the hostname for this system:" 10 60 "KaaijkOS") || abort_install
TARGET_HOSTNAME="${TARGET_HOSTNAME:-KaaijkOS}"

while true; do
    ROOT_PASS=$(dlg --title " Profile Setup - Root Password " --insecure --passwordbox "\nEnter a password for the 'root' administrator account:" 10 64) || abort_install
    ROOT_PASS2=$(dlg --title " Confirm Root Password " --insecure --passwordbox "\nConfirm the 'root' password:" 10 64) || abort_install
    if [ -z "$ROOT_PASS" ]; then
        dlg --title " Error " --msgbox "\nPassword cannot be empty." 8 45
    elif [ "$ROOT_PASS" != "$ROOT_PASS2" ]; then
        dlg --title " Error " --msgbox "\nPasswords do not match. Please try again." 8 55
    else
        break
    fi
done

EXTRA_USER=""
EXTRA_PASS=""
if dlg --title " Profile Setup - Additional User " --yesno "\nWould you like to create a standard user account (with sudo privileges) in addition to 'root'?" 10 68; then
    EXTRA_USER=$(dlg --title " Username " --inputbox "\nEnter username (lowercase, e.g. admin):" 10 60 "") || abort_install
    if [ -n "$EXTRA_USER" ]; then
        while true; do
            EXTRA_PASS=$(dlg --title " Password for ${EXTRA_USER} " --insecure --passwordbox "\nEnter a password for '${EXTRA_USER}':" 10 60) || abort_install
            EXTRA_PASS2=$(dlg --title " Confirm Password " --insecure --passwordbox "\nConfirm password for '${EXTRA_USER}':" 10 60) || abort_install
            if [ -n "$EXTRA_PASS" ] && [ "$EXTRA_PASS" = "$EXTRA_PASS2" ]; then
                break
            fi
            dlg --title " Error " --msgbox "\nPasswords are empty or do not match." 8 50
        done
    fi
fi

# ------------------------------------------------------------------------------
# 8. SSH CONFIGURATION & GITHUB KEY IMPORT
# ------------------------------------------------------------------------------
ENABLE_SSH="yes"
GITHUB_USER=""
if dlg --title " SSH Setup " --yesno "\nInstall and enable the OpenSSH Server (sshd) on boot?" 9 62; then
    ENABLE_SSH="yes"
    GITHUB_USER=$(dlg --title " Import SSH Identity from GitHub " \
        --inputbox "\nEnter a GitHub username to import their public SSH keys into authorized_keys (or leave empty to skip):" 11 68 "") || abort_install
else
    ENABLE_SSH="no"
fi

# ------------------------------------------------------------------------------
# 9. REVIEW & CONFIRM
# ------------------------------------------------------------------------------
if [ "$STORAGE_MODE" = "guided" ]; then
    STORAGE_SUMMARY="Guided Whole-Disk on ${TARGET_DISK} (/boot: ${BOOT_SIZE}, Swap: ${SWAP_MODE}${SWAP_SIZE:+ $SWAP_SIZE})"
else
    STORAGE_SUMMARY="Custom Layout (/: ${CUSTOM_ROOT_PART}, /boot: ${CUSTOM_BOOT_PART:-none}, /home: ${CUSTOM_HOME_PART:-none})"
fi

SUMMARY="\nPlease review your installation settings before proceeding:\n
  • Firmware / Boot : ${BOOT_MODE} ($([ "$BOOT_MODE" = "UEFI" ] && echo "systemd-boot + UKI" || echo "GRUB i386-pc BIOS"))
  • Storage Layout  : ${STORAGE_SUMMARY}
  • Hostname        : ${TARGET_HOSTNAME}
  • Keyboard / Lang : ${KEYMAP}  |  ${LOCALE}
  • Timezone        : ${TIMEZONE}
